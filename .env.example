# Duell Monsters Classic - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# Frontend
VITE_YGOPRO_API_URL=https://db.ygoprodeck.com/api/v7
VITE_YGOPRO_IMAGE_URL=https://images.ygoprodeck.com/images/cards
VITE_API_URL=http://localhost:3001/api

# Database (Docker PostgreSQL)
POSTGRES_DB=dmc
POSTGRES_USER=dmc_user
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://dmc_user:CHANGE_ME@localhost:5432/dmc

# Backend
JWT_SECRET=CHANGE_ME
PORT=3001
